# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database ---
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://sentrix:sentrix@localhost:5432/sentrix
USE_SQLITE_FOR_DEV=False

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sentrix <noreply@sentrix.local>

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI Chatbot ---
# Options: free (built-in 0-key offline NLP), groq (free cloud tier), ollama (local LLM), anthropic
CHATBOT_PROVIDER=free

# Groq (Free tier API key from https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Free local models like llama3, mistral - http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude (Paid API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Business rules ---
DEFAULT_LOW_STOCK_THRESHOLD=10
EXPIRY_ALERT_DAYS_AHEAD=7
